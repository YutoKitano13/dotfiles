{
  "cleanupPeriodDays": 10000,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(date:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh api:*)",
      "Bash(playwright-cli:*)",
      "Bash(gcloud auth list)",
      "Bash(gcloud config list *)",
      "Bash(gcloud --version)",
      "Bash(bq version)",
      "Bash(bq ls *)",
      "Bash(bq show *)",
      "Bash(bq query *)",
      "Bash(bq head *)",
      "WebFetch",
      "WebSearch",
      "Skill",
      "mcp__context7",
      "mcp__mastra",
      "mcp__plugin_figma_figma"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(rm -r *)"
    ],
    "defaultMode": "auto"
  },
  "model": "fable[1m]",
  "statusLine": {
    "type": "command",
    "command": "echo \"$(bunx ccusage@latest statusline) | $(basename \"$PWD\")($(git branch --show-current 2>/dev/null || echo '-'))\""
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "postman@claude-plugins-official": true,
    "fangrowth@fangrowth-workspace": true,
    "context7@context7-marketplace": true
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "fangrowth-workspace": {
      "source": {
        "source": "github",
        "repo": "excitejp/fangrowth-workspace"
      },
      "autoUpdate": true
    },
    "context7-marketplace": {
      "source": {
        "source": "github",
        "repo": "upstash/context7"
      }
    }
  },
  "language": "Japanese",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "advisorModel": "fable",
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}